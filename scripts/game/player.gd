extends CharacterBody2D
class_name Player
## The hero: a small human silhouette. Physics lives here, art is only the
## AnimatedSprite2D (sprite sheet generated by tools/gen_char.py), so changing
## the art can never change the physics.

signal jumped
signal landed
signal stepped
signal died

const SPEED := 250.0
const ACCEL := 1250.0
const AIR_ACCEL := 900.0
const FRICTION := 1700.0
const JUMP_VELOCITY := -610.0
const GRAVITY := 1850.0
const MAX_FALL := 950.0
const COYOTE_TIME := 0.10
const BUFFER_TIME := 0.12
const PUSH_SPEED := 105.0
const SPRITE_SCALE := 0.62
const HALF_HEIGHT := 22.0

var frozen := false
var camera: Camera2D
var sprite: AnimatedSprite2D

var _coyote := 0.0
var _buffer := 0.0
var _facing := 1.0
var _was_on_floor := false
var _land_t := 0.0
var _pushing := false
var _anim := ""


## Builds the animation set from the sheet: 8 columns x 6 rows of 96 px cells.
static func make_frames() -> SpriteFrames:
	var tex: Texture2D = load("res://assets/art/char_sheet.png")
	var sf := SpriteFrames.new()
	if sf.has_animation("default"):
		sf.remove_animation("default")
	# name, row, frames, fps, loop
	var defs := [
		["idle", 0, 6, 6.0, true],
		["walk", 1, 8, 10.0, true],
		["jump", 2, 2, 6.0, false],
		["fall", 3, 2, 6.0, false],
		["land", 4, 3, 16.0, false],
		["die", 5, 8, 11.0, false],
	]
	for d in defs:
		var anim: String = d[0]
		var row: int = d[1]
		var count: int = d[2]
		sf.add_animation(anim)
		sf.set_animation_speed(anim, d[3])
		sf.set_animation_loop(anim, d[4])
		for i in range(count):
			var at := AtlasTexture.new()
			at.atlas = tex
			at.region = Rect2(i * 96, row * 96, 96, 96)
			sf.add_frame(anim, at)
	return sf


func _ready() -> void:
	collision_layer = 2
	collision_mask = 1 | 4
	floor_snap_length = 10.0

	var cs := CollisionShape2D.new()
	var cap := CapsuleShape2D.new()
	cap.radius = 9.0
	cap.height = HALF_HEIGHT * 2.0
	cs.shape = cap
	add_child(cs)

	sprite = AnimatedSprite2D.new()
	sprite.sprite_frames = make_frames()
	sprite.scale = Vector2(SPRITE_SCALE, SPRITE_SCALE)
	# feet are on row 90 of the 96 px cell; put them on the capsule's bottom
	sprite.position = Vector2(0.0, HALF_HEIGHT - 42.0 * SPRITE_SCALE)
	sprite.frame_changed.connect(_on_frame)
	add_child(sprite)
	sprite.play("idle")
	_anim = "idle"


func _physics_process(delta: float) -> void:
	if frozen:
		velocity.x = move_toward(velocity.x, 0.0, FRICTION * delta)
		velocity.y = minf(velocity.y + GRAVITY * delta, MAX_FALL)
		move_and_slide()
		return

	var on_floor := is_on_floor()
	_coyote = COYOTE_TIME if on_floor else maxf(_coyote - delta, 0.0)
	if Input.is_action_just_pressed("jump"):
		_buffer = BUFFER_TIME
	else:
		_buffer = maxf(_buffer - delta, 0.0)

	if not on_floor:
		velocity.y = minf(velocity.y + GRAVITY * delta, MAX_FALL)

	if _buffer > 0.0 and _coyote > 0.0:
		velocity.y = JUMP_VELOCITY
		_buffer = 0.0
		_coyote = 0.0
		jumped.emit()
	# variable jump height: releasing early cuts the jump short
	if Input.is_action_just_released("jump") and velocity.y < -220.0:
		velocity.y *= 0.5

	var axis := Input.get_axis("move_left", "move_right")
	var rate := FRICTION
	if absf(axis) >= 0.01:
		rate = ACCEL if on_floor else AIR_ACCEL
	velocity.x = move_toward(velocity.x, axis * SPEED, rate * delta)
	if absf(axis) > 0.05:
		_facing = signf(axis)

	var vy_before := velocity.y
	move_and_slide()
	_push_crates(axis)

	var now_floor := is_on_floor()
	if now_floor and not _was_on_floor and vy_before > 380.0:
		_land_t = 0.2
		landed.emit()
	_was_on_floor = now_floor

	_update_anim(delta, now_floor)
	_update_camera(delta)


func _push_crates(axis: float) -> void:
	_pushing = false
	if absf(axis) < 0.1:
		return
	for i in get_slide_collision_count():
		var c := get_slide_collision(i)
		var body := c.get_collider()
		if body is RigidBody2D and absf(c.get_normal().x) > 0.8 \
				and signf(-c.get_normal().x) == signf(axis):
			var rb := body as RigidBody2D
			rb.linear_velocity.x = signf(axis) * PUSH_SPEED * minf(absf(axis) * 1.2, 1.0)
			_pushing = true


func _update_anim(delta: float, on_floor: bool) -> void:
	var want := "idle"
	var scale_speed := 1.0
	if not on_floor:
		want = "jump" if velocity.y < 0.0 else "fall"
	elif _land_t > 0.0:
		want = "land"
	elif _pushing:
		want = "walk"
		scale_speed = 0.5
	elif absf(velocity.x) > 25.0:
		want = "walk"
		scale_speed = clampf(absf(velocity.x) / SPEED, 0.45, 1.1)
	_land_t = maxf(_land_t - delta, 0.0)
	if want != _anim:
		_anim = want
		sprite.play(want)
	sprite.speed_scale = scale_speed
	sprite.flip_h = _facing < 0.0


func _update_camera(delta: float) -> void:
	if camera == null:
		return
	# the camera looks ahead of the hero and settles back when standing still
	var target: float = camera.offset.x
	if absf(velocity.x) > 30.0:
		target = _facing * 150.0
	camera.offset.x = lerpf(camera.offset.x, target, minf(delta * 1.6, 1.0))


func _on_frame() -> void:
	if sprite.animation == "walk" and (sprite.frame == 0 or sprite.frame == 4) and is_on_floor():
		stepped.emit()


func kill() -> void:
	if frozen:
		return
	frozen = true
	velocity.x = 0.0
	_anim = "die"
	sprite.speed_scale = 1.0
	sprite.play("die")
	died.emit()


func revive(pos: Vector2) -> void:
	position = pos
	velocity = Vector2.ZERO
	frozen = false
	_coyote = 0.0
	_buffer = 0.0
	_land_t = 0.0
	_pushing = false
	_was_on_floor = false
	_anim = "idle"
	sprite.speed_scale = 1.0
	sprite.play("idle")


func freeze_idle() -> void:
	frozen = true
	velocity.x = 0.0
	_anim = "idle"
	sprite.speed_scale = 1.0
	sprite.play("idle")
