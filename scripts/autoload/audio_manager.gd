extends Node
## All audio. Two buses (Music, SFX) are created at startup so the volume
## sliders change real bus volume. Sounds are .wav files in assets/audio/
## (generated by tools/gen_audio.py). Players are created once and reused.

const SFX_NAMES := ["jump", "land", "step", "lever", "door", "checkpoint", "death", "end"]

var _ambience: AudioStreamPlayer
var _players: Dictionary = {}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_ensure_bus("Music")
	_ensure_bus("SFX")

	_ambience = AudioStreamPlayer.new()
	_ambience.bus = "Music"
	_ambience.stream = _load_loop("res://assets/audio/ambience.wav")
	add_child(_ambience)

	for n in SFX_NAMES:
		var path := "res://assets/audio/%s.wav" % n
		if not ResourceLoader.exists(path):
			continue
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		p.stream = load(path)
		add_child(p)
		_players[n] = p

	GameState.state_changed.connect(func(_a: int, _b: int) -> void: _refresh_pause())
	GameState.activity_changed.connect(_refresh_pause)
	GameState.settings_changed.connect(apply_volumes)
	apply_volumes()
	if _ambience.stream != null:
		_ambience.play()


func play(sfx_name: String) -> void:
	var p: AudioStreamPlayer = _players.get(sfx_name)
	if p != null:
		p.play()


func apply_volumes() -> void:
	_set_bus("Music", float(GameState.settings["music_volume"]))
	_set_bus("SFX", float(GameState.settings["sfx_volume"]))


func _set_bus(bus_name: String, linear: float) -> void:
	var idx := AudioServer.get_bus_index(bus_name)
	if idx < 0:
		return
	AudioServer.set_bus_mute(idx, linear <= 0.001)
	AudioServer.set_bus_volume_db(idx, linear_to_db(maxf(linear, 0.001)))


func _refresh_pause() -> void:
	var paused := GameState.is_logic_paused()
	_ambience.stream_paused = paused
	for p in _players.values():
		p.stream_paused = paused


func _ensure_bus(bus_name: String) -> void:
	if AudioServer.get_bus_index(bus_name) >= 0:
		return
	AudioServer.add_bus()
	var idx := AudioServer.bus_count - 1
	AudioServer.set_bus_name(idx, bus_name)
	AudioServer.set_bus_send(idx, "Master")


func _load_loop(path: String) -> AudioStream:
	if not ResourceLoader.exists(path):
		return null
	var src := load(path) as AudioStreamWAV
	if src == null:
		return null
	var s := src.duplicate() as AudioStreamWAV
	s.loop_mode = AudioStreamWAV.LOOP_FORWARD
	s.loop_begin = 0
	s.loop_end = int(s.data.size() * 0.5)  # 16-bit mono: 2 bytes per sample
	return s
